# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------------------
# Base de datos — Postgres alojado en Supabase
# ---------------------------------------------------------------------------
# Session Pooler (puerto 5432). Es el que usamos: admite sentencias preparadas.
# Si algun dia se cambia al Transaction Pooler (6543), hay que poner
# DATABASE_STATEMENT_CACHE_SIZE=0 o asyncpg fallara de forma intermitente.
DATABASE_URL=postgresql://postgres.POR_CONFIGURAR:POR_CONFIGURAR@aws-0-POR_CONFIGURAR.pooler.supabase.com:5432/postgres
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_STATEMENT_CACHE_SIZE=100
DATABASE_COMMAND_TIMEOUT=30

# ---------------------------------------------------------------------------
# Supabase — solo autenticacion. Sin SDK: REST + verificacion local de JWT.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://POR_CONFIGURAR.supabase.co
SUPABASE_PROJECT_REF=POR_CONFIGURAR
# Llave de servicio. Jamas sale del backend ni llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=POR_CONFIGURAR
# Dominio del correo sintetico: el usuario teclea su cedula, el backend
# la traduce a <documento>@<dominio> para hablar con Supabase Auth.
SUPABASE_SYNTHETIC_EMAIL_DOMAIN=buenpastor.app
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=3600

# ---------------------------------------------------------------------------
# Cloudinary — avatares, documentos y comprobantes
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=POR_CONFIGURAR
CLOUDINARY_API_KEY=POR_CONFIGURAR
CLOUDINARY_API_SECRET=POR_CONFIGURAR
CLOUDINARY_UPLOAD_FOLDER=kingdom-core

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=
